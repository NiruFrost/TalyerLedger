# Public Supabase configuration (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false unless Supabase sign-up and tenant provisioning are intentionally enabled.
NEXT_PUBLIC_ALLOW_SIGN_UP=false

# Private server-only values (optional until the corresponding adapter is enabled)
# Never prefix private values with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 adapter (optional and not active in Phase 0)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=talyer-ledger
R2_ENDPOINT=
